{
  "name": "agent-usage",
  "version": "3.0.2",
  "description": "Desktop widget for agent usage monitoring",
  "scripts": {
    "dev": "tauri dev",
    "dev:debug": "DEBUG_LOG=1 tauri dev",
    "dev:renderer": "vite",
    "clean": "rm -rf dist-renderer",
    "build": "npm run build:renderer",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "package": "CI=true tauri build",
    "package:styled": "tauri build",
    "package:debug": "CI=true tauri build --debug",
    "generate-icons": "tauri icon assets/icon.png"
  },
  "keywords": [
    "claude",
    "usage",
    "widget",
    "tauri"
  ],
  "author": "James Bolton",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.10.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.0.0",
    "@rollup/rollup-darwin-x64": "^4.0.0",
    "@rollup/rollup-linux-x64-gnu": "^4.0.0",
    "@rollup/rollup-win32-x64-msvc": "^4.0.0"
  }
}
