{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main widget window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-get-credentials",
    "allow-save-credentials",
    "allow-delete-credentials",
    "allow-validate-session-key",
    "allow-detect-session-key",
    "allow-fetch-usage-data",
    "allow-get-cached-usage",
    "allow-get-codex-credentials",
    "allow-save-codex-credentials",
    "allow-delete-codex-credentials",
    "allow-detect-codex-token",
    "allow-fetch-codex-usage",
    "allow-get-cached-codex-usage",
    "allow-minimize-window",
    "allow-close-window",
    "allow-resize-window",
    "allow-get-window-position",
    "allow-set-window-position",
    "allow-open-external",
    "allow-get-platform",
    "allow-get-usage-history",
    "allow-save-usage-history-entry",
    "allow-clear-usage-history",
    "allow-get-refresh-interval",
    "allow-set-refresh-interval",
    "allow-get-theme",
    "allow-set-theme",
    "allow-get-background-hue",
    "allow-set-background-hue",
    "allow-is-auto-start-supported",
    "allow-get-auto-start",
    "allow-set-auto-start",
    "allow-update-tray-usage"
  ]
}
